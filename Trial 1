<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AI Pose Trainer Pro</title>
    
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/pose-detection"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/knn-classifier"></script>

    <style>
        :root { --neon: #00ffcc; --bg: #0a0a0a; --panel: #1a1a1a; }
        body { margin: 0; background: var(--bg); color: white; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; display: flex; flex-direction: column; align-items: center; }
        
        header { width: 100%; padding: 15px; background: var(--panel); text-align: center; border-bottom: 2px solid #333; }
        #msg { color: var(--neon); font-weight: bold; font-size: 0.9rem; margin-top: 5px; }

        #container { position: relative; width: 95vw; height: 70vw; max-width: 500px; max-height: 375px; margin: 15px 0; border: 3px solid #333; border-radius: 15px; overflow: hidden; background: #000; }
        video { position: absolute; width: 100%; height: 100%; object-fit: cover; z-index: 1; transform: scaleX(-1); }
        canvas { position: absolute; width: 100%; height: 100%; z-index: 2; pointer-events: none; transform: scaleX(-1); }

        .dashboard { width: 95vw; max-width: 500px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding-bottom: 30px; }
        .card { background: var(--panel); padding: 15px; border-radius: 12px; text-align: center; border: 1px solid #333; }
        
        .btn { border: none; border-radius: 8px; color: white; font-weight: bold; cursor: pointer; transition: 0.2s; touch-action: none; width: 100%; }
        .btn-train { padding: 20px 10px; font-size: 1rem; margin-top: 10px; }
        .btn-util { padding: 10px; font-size: 0.8rem; background: #444; margin-top: 5px; }
        
        .count { font-size: 1.5rem; font-weight: bold; display: block; margin-bottom: 5px; }
        
        /* Prediction Overlay */
        #prediction-ribbon { position: absolute; top: 10px; left: 10px; padding: 8px 15px; background: rgba(0,0,0,0.7); border-radius: 20px; color: var(--neon); z-index: 10; font-weight: bold; border: 1px solid var(--neon); display: none; }
    </style>
</head>
<body>

<header>
    <div style="font-weight: 900; letter-spacing: 2px;">POSETRAINER <span style="color:var(--neon)">PRO</span></div>
    <div id="msg">INITIALIZING CAMERA...</div>
</header>

<div id="container">
    <div id="prediction-ribbon">DETECTED: <span id="res-val">---</span></div>
    <video id="webcam" autoplay playsinline muted></video>
    <canvas id="canvas"></canvas>
</div>

<div class="dashboard">
    <div class="card">
        <span class="count" id="c0">0</span>
        <div style="font-size: 0.7rem; color: #aaa;">CLASS A (e.g. Hands Up)</div>
        <button class="btn btn-train" id="btn-0" style="background: #2ecc71;">TRAIN A</button>
    </div>
    
    <div class="card">
        <span class="count" id="c1">0</span>
        <div style="font-size: 0.7rem; color: #aaa;">CLASS B (e.g. Squat)</div>
        <button class="btn btn-train" id="btn-1" style="background: #e74c3c;">TRAIN B</button>
    </div>

    <div class="card" style="grid-column: span 2;">
        <span class="count" id="cbg">0</span>
        <div style="font-size: 0.7rem; color: #aaa;">BACKGROUND (No person or neutral)</div>
        <button class="btn btn-train" id="btn-bg" style="background: #7f8c8d;">TRAIN BG</button>
    </div>

    <div class="card" style="grid-column: span 2; display: flex; gap: 10px; background: transparent; border: none;">
        <button class="btn btn-util" onclick="saveModel()">💾 DOWNLOAD BRAIN</button>
        <button class="btn btn-util" onclick="document.getElementById('loader').click()">📂 LOAD BRAIN</button>
        <input type="file" id="loader" style="display:none" onchange="loadModel(event)">
    </div>
</div>

<script>
    let detector, classifier, video, canvas, ctx;
    let counts = {0:0, 1:0, bg:0};

    async function init() {
        video = document.getElementById('webcam');
        canvas = document.getElementById('canvas');
        ctx = canvas.getContext('2d');
        classifier = knnClassifier.create();

        try {
            const model = poseDetection.SupportedModels.MoveNet;
            detector = await poseDetection.createDetector(model);
            
            const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
            video.srcObject = stream;

            video.onloadedmetadata = () => {
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                document.getElementById('msg').innerText = "AI ACTIVE - STAND 5-8 FEET AWAY";
                loop();
            };
        } catch (e) { document.getElementById('msg').innerText = "ERROR: " + e.message; }
    }

    async function loop() {
        const poses = await detector.estimatePoses(video);
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        if (poses.length > 0) {
            const pose = poses[0];
            drawSkeleton(pose);

            // Predict if we have data
            if (classifier.getNumClasses() > 0) {
                const feat = tf.tensor2d(pose.keypoints.map(k => [k.x, k.y]).flat(), [1, 34]);
                const res = await classifier.predictClass(feat);
                
                document.getElementById('prediction-ribbon').style.display = "block";
                document.getElementById('res-val').innerText = res.label.toUpperCase();
                feat.dispose();
            }
        }
        requestAnimationFrame(loop);
    }

    function drawSkeleton(pose) {
        // Draw Points
        pose.keypoints.forEach(kp => {
            if (kp.score > 0.4) {
                ctx.beginPath();
                ctx.arc(kp.x, kp.y, 8, 0, 2*Math.PI);
                ctx.fillStyle = "white"; ctx.fill();
                ctx.strokeStyle = "#00ffcc"; ctx.lineWidth = 2; ctx.stroke();
            }
        });
    }

    async function train(id) {
        const poses = await detector.estimatePoses(video);
        if (poses.length > 0) {
            const feat = tf.tensor2d(poses[0].keypoints.map(k => [k.x, k.y]).flat(), [1, 34]);
            classifier.addExample(feat, id);
            counts[id]++;
            document.getElementById('c'+id).innerText = counts[id];
            feat.dispose();
        }
    }

    // --- SAVE & LOAD LOGIC ---
    function saveModel() {
        const dataset = classifier.getClassifierDataset();
        const datasetObj = Object.entries(dataset).map(([label, data]) => [label, Array.from(data.dataSync()), data.shape]);
        const json = JSON.stringify(datasetObj);
        const blob = new Blob([json], {type: "application/json"});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a'); a.href = url; a.download = "my_ai_model.json"; a.click();
    }

    async function loadModel(event) {
        const reader = new FileReader();
        reader.onload = async (e) => {
            const datasetObj = JSON.parse(e.target.result);
            const dataset = Object.fromEntries(datasetObj.map(([label, data, shape]) => [label, tf.tensor2d(data, shape)]));
            classifier.setClassifierDataset(dataset);
            document.getElementById('msg').innerText = "MODEL LOADED SUCCESSFULLY!";
        };
        reader.readAsText(event.target.files[0]);
    }

    // Button Setup
    let timer;
    ['0', '1', 'bg'].forEach(id => {
        const b = document.getElementById('btn-'+id);
        const start = (e) => { e.preventDefault(); timer = setInterval(() => train(id), 100); };
        const stop = () => clearInterval(timer);
        b.addEventListener('touchstart', start); b.addEventListener('touchend', stop);
        b.addEventListener('mousedown', start); b.addEventListener('mouseup', stop);
    });

    init();
</script>
</body>
</html>
